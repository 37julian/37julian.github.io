# Garmin Connect — SSO Login (E-Mail + Passwort).
# Wird nur einmalig vom Setup-Skript gebraucht, danach läuft alles über
# den OAuth-Token in .garth/.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Anthropic API Key für Claude-Analysen
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: Modell für AI-Analysen (Default: claude-sonnet-4-6)
# Verfügbar: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Wie viele Tage Health-Daten beim Sync rückwirkend laden (Default: 90)
HEALTH_SYNC_DAYS=90

# Optional: Wie viele Aktivitäten pro Sync laden (Default: 50)
ACTIVITY_SYNC_LIMIT=50

# Optional: Server Port (Default: 8000)
PORT=8000
